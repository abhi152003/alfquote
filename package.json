{
  "name": "alfquote-workspace",
  "version": "0.0.0",
  "description": "Hook-aware discovery, assessment, and quoting for Uniswap v4 DualPool through IALFHook views",
  "type": "module",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "node --import tsx --env-file-if-exists=.env --watch scripts/phase1/verify-mainnet.ts",
    "build:lib": "npm run build --workspace alfquote",
    "build": "npm run build --workspace alfquote && npm run build --workspace @alfquote/cli",
    "type-check": "npm run type-check --workspace alfquote && npm run type-check --workspace @alfquote/cli && tsc --noEmit -p tsconfig.json",
    "pretest": "npm run build:lib",
    "test": "vitest run",
    "prespike": "npm run build:lib",
    "spike": "node --import tsx --env-file-if-exists=.env scripts/phase1/verify-mainnet.ts",
    "preproof": "npm run build:lib",
    "proof": "node --import tsx --env-file-if-exists=.env scripts/phase1/prove-liquidity.ts",
    "presimulate": "npm run build:lib",
    "simulate": "node --import tsx --env-file-if-exists=.env scripts/phase1/simulate-swap.ts",
    "presimulate:diagnostic": "npm run build:lib",
    "simulate:diagnostic": "ALFQUOTE_DIAGNOSTIC=1 node --import tsx --env-file-if-exists=.env scripts/phase1/simulate-swap.ts",
    "presweep": "npm run build:lib",
    "sweep": "node --import tsx --env-file-if-exists=.env scripts/phase1/sweep-sizes.ts",
    "prefork": "npm run build:lib",
    "fork": "node --import tsx --env-file-if-exists=.env scripts/tenderly/fork-execute.ts",
    "prefork:diagnostic": "npm run build:lib",
    "fork:diagnostic": "ALFQUOTE_DIAGNOSTIC=1 node --import tsx --env-file-if-exists=.env scripts/tenderly/fork-execute.ts",
    "check-no-send": "bash scripts/check-no-send.sh",
    "check-package-boundaries": "bash scripts/check-package-boundaries.sh",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
