# ALFQuote mainnet verification spike configuration.
# Copy this file to .env and fill in real values. Never commit .env.

# Ethereum mainnet JSON-RPC endpoint (http/https) or WebSocket endpoint (ws/wss).
# Example: https://eth-mainnet.g.alchemy.com/v2/<API_KEY>
ETHEREUM_RPC_URL=

# Address used as msg.sender for the dry-run Universal Router simulation (WO-4).
# Required for `npm run simulate`. Never used to sign or send a transaction.
ALFQUOTE_SIMULATION_FROM=

# Optional exact-input size in whole USDC (default 100). Overridden by --amount.
# ALFQUOTE_AMOUNT_USDC=1

# Optional Ethereum block for spike, proof, and simulate (archive RPC required).
# Overridden by --block. Omit for latest-state.
# ALFQUOTE_BLOCK=

# Optional slippage for amountOutMinimum, in basis points (default 50 = 0.5%).
# Non-default values are diagnostic-only (`npm run simulate:diagnostic`).
# ALFQUOTE_SLIPPAGE_BPS=50

# --- Controlled-fork execution proof (WO-7, `npm run fork`) ---
# Tenderly Virtual Environment forking Ethereum mainnet. Create it at
# https://dashboard.tenderly.co/virtual-environments (Static sync; unique chain
# id, not 1). TENDERLY_FORK_BLOCK = the Ethereum head block the fork started
# from (check the environment page). TENDERLY_ADMIN_RPC_URL is a SECRET: it can
# mutate the fork and must never be committed, logged, or shared.
TENDERLY_PUBLIC_RPC_URL=
TENDERLY_ADMIN_RPC_URL=
TENDERLY_FORK_BLOCK=
TENDERLY_CHAIN_ID=

# Dedicated test address for funding, approvals, and the fork swap. Never a
# real wallet; nothing is signed with it on mainnet.
ALFQUOTE_TENDERLY_FROM=

# Public/read-only Tenderly evidence link (e.g. the Virtual Environment dashboard
# URL) recorded in docs/fork-evidence.json. Required for the release run
# (`npm run fork`); optional for diagnostics.
# TENDERLY_EVIDENCE_URL=
