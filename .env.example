# ALFQuote mainnet verification spike configuration.
# Copy this file to .env and fill in real values. Never commit .env.

# Ethereum mainnet JSON-RPC endpoint (http/https) or WebSocket endpoint (ws/wss).
# Example: https://eth-mainnet.g.alchemy.com/v2/<API_KEY>
ETHEREUM_RPC_URL=

# Address used as msg.sender for the dry-run Universal Router simulation (WO-4).
# Required for `npm run simulate`. Never used to sign or send a transaction.
ALFQUOTE_SIMULATION_FROM=

# Optional exact-input size in whole USDC (default 100). Overridden by --amount.
# ALFQUOTE_AMOUNT_USDC=1

# Optional Ethereum block for spike, proof, and simulate (archive RPC required).
# Overridden by --block. Omit for latest-state.
# ALFQUOTE_BLOCK=

# Optional slippage for amountOutMinimum, in basis points (default 50 = 0.5%).
# Non-default values are diagnostic-only (`npm run simulate:diagnostic`).
# ALFQUOTE_SLIPPAGE_BPS=50
